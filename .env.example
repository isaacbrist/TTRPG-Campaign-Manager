# =============================================================================
# D&D Campaign Manager — Backend Environment Variables
# =============================================================================
# The .NET backend reads configuration from appsettings.json, but any setting
# can be overridden via environment variables using double-underscore (__) as
# the section separator (e.g. Anthropic:ApiKey → Anthropic__ApiKey).
#
# For local development, set these in appsettings.Development.json (gitignored).
# For production / Docker / CI, export these environment variables instead.
#
# Copy this file to .env (gitignored) and fill in real values, or set each
# variable directly in your shell / container environment.
# =============================================================================

# ── Anthropic API ─────────────────────────────────────────────────────────────
# Required. Used by ClaudeService to call the Anthropic API for AI features
# (session note processing, NPC generation, campaign recaps).
# Get your key at https://console.anthropic.com/
Anthropic__ApiKey=sk-ant-your-api-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite connection string. Defaults to a local file in the working directory.
# Change the path to store the database elsewhere (e.g. a Docker volume mount).
ConnectionStrings__Default=Data Source=campaign_manager.db

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
# Controls which appsettings.<Environment>.json file is loaded and enables
# developer-friendly error pages. Use "Development" locally, "Production" in prod.
ASPNETCORE_ENVIRONMENT=Development

# ── CORS ──────────────────────────────────────────────────────────────────────
# The backend allows requests from http://localhost:3000 by default (hardcoded
# in Program.cs). If you run the frontend on a different port in production,
# update AllowedOrigins in Program.cs or add a config key here.
# AllowedOrigins=http://localhost:3000
